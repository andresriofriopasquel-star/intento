style_css = """/* ==========================================================================
   CALENDARIO DE ADVIENTO DIGITAL — ANDRÉS & ANY
   Estética: Invernal, Celestes Pastel, Nieve, Minimalismo Artesanal
   Metodología: Mobile First
   ========================================================================== */

:root {
  --celeste-pastel: #B9DFF2;
  --celeste-claro: #DDF1FA;
  --azul-hielo: #EAF7FC;
  --blanco-nieve: #FFFFFF;
  --azul-grisaceo: #789CB2;
  --azul-oscuro: #405C70;
  --azul-profundo: #2B4252;
  --plateado-sutil: #D4E1E8;
  --sombra-suave: rgba(64, 92, 112, 0.14);
  --sombra-fuerte: rgba(43, 66, 82, 0.24);

  --font-serif: 'Cormorant Garamond', Georgia, serif;
  --font-script: 'Dancing Script', cursive;
  --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;

  --radius-card: 18px;
  --radius-door: 16px;
}

*,
*::before,
*::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html, body {
  width: 100%;
  max-width: 100%;
  min-height: 100vh;
  overflow-x: hidden;
  font-family: var(--font-sans);
  color: var(--azul-oscuro);
  background: linear-gradient(170deg, var(--azul-hielo) 0%, var(--celeste-claro) 52%, var(--celeste-pastel) 100%);
  -webkit-font-smoothing: antialiased;
}

/* Lienzo de nieve detrás de todo */
#snow-canvas {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 1;
}

.sparkles-layer {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 2;
  overflow: hidden;
}

.sparkle-dot {
  position: absolute;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: radial-gradient(circle, #FFFFFF 0%, rgba(255,255,255,0) 70%);
  animation: twinkle var(--dur, 4s) ease-in-out infinite;
  opacity: 0;
}

@keyframes twinkle {
  0%, 100% { opacity: 0; transform: scale(0.6); }
  50% { opacity: 0.85; transform: scale(1.3); }
}

/* Controles superiores */
.top-controls {
  position: fixed;
  top: 12px;
  right: 12px;
  z-index: 40;
  display: flex;
  gap: 8px;
}

.pill-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 7px 13px;
  border-radius: 999px;
  border: 1px solid rgba(255, 255, 255, 0.85);
  background: rgba(255, 255, 255, 0.78);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  color: var(--azul-oscuro);
  font-family: var(--font-sans);
  font-size: 0.78rem;
  font-weight: 600;
  cursor: pointer;
  box-shadow: 0 4px 14px var(--sombra-suave);
  transition: transform 0.2s ease, background 0.2s ease;
}

.pill-btn:hover {
  background: var(--blanco-nieve);
  transform: translateY(-1px);
}

.pill-btn:active {
  transform: scale(0.96);
}

.hidden {
  display: none !important;
}

/* Pantallas principales */
.screen {
  position: relative;
  z-index: 10;
  min-height: 100vh;
  width: 100%;
  transition: opacity 0.65s ease, transform 0.65s ease;
}

.screen.fade-out {
  opacity: 0;
  transform: translateY(-14px);
  pointer-events: none;
}

/* ==========================================================================
   PANTALLA 1: BIENVENIDA CON SOBRE
   ========================================================================== */
.screen-welcome {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px 18px;
  text-align: center;
}

.welcome-wrapper {
  width: 100%;
  max-width: 460px;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.eyebrow-tag {
  font-size: 0.72rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--azul-grisaceo);
  font-weight: 600;
  margin-bottom: 6px;
}

.welcome-title {
  font-family: var(--font-serif);
  font-size: clamp(2.4rem, 7vw, 3.3rem);
  font-weight: 700;
  color: var(--azul-oscuro);
  line-height: 1.08;
  margin-bottom: 6px;
}

.welcome-subtitle {
  font-family: var(--font-script);
  font-size: clamp(1.5rem, 5vw, 1.95rem);
  color: var(--azul-grisaceo);
  margin-bottom: 26px;
}

/* Escenario del sobre */
.envelope-stage {
  position: relative;
  width: 100%;
  max-width: 320px;
  height: 215px;
  margin: 0 auto 24px;
  perspective: 1000px;
  transition: height 0.6s ease, max-width 0.6s ease;
}

.envelope-stage.opened {
  max-width: 420px;
  height: 390px;
}

.envelope {
  position: relative;
  width: 100%;
  height: 100%;
  cursor: pointer;
  animation: gentleFloat 4.2s ease-in-out infinite;
  outline: none;
}

.envelope.is-open {
  animation: none;
  cursor: default;
}

@keyframes gentleFloat {
  0%, 100% { transform: translateY(0px); }
  50% { transform: translateY(-7px); }
}

.envelope-back {
  position: absolute;
  inset: 0;
  background: linear-gradient(145deg, #FFFFFF 0%, #EAF7FC 100%);
  border-radius: 14px;
  border: 1.5px solid var(--plateado-sutil);
  box-shadow: 0 16px 36px var(--sombra-suave);
  transition: opacity 0.5s ease;
}

/* Bolsillo frontal del sobre */
.envelope-pocket {
  position: absolute;
  inset: 0;
  border-radius: 14px;
  overflow: hidden;
  z-index: 4;
  pointer-events: none;
  transition: opacity 0.45s ease;
}

.envelope-pocket::before {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, #F7FCFF 50%, transparent 50%),
              linear-gradient(225deg, #EFF8FC 50%, transparent 50%);
  clip-path: polygon(0 0, 50% 56%, 100% 0, 100% 100%, 0 100%);
  border-top: 1px solid rgba(120, 156, 178, 0.25);
}

.envelope-pocket::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(221, 241, 250, 0.35) 0%, #FFFFFF 100%);
  clip-path: polygon(0 100%, 50% 48%, 100% 100%);
  border-top: 1px solid rgba(120, 156, 178, 0.2);
}

/* Solapa superior del sobre */
.envelope-flap {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 58%;
  background: linear-gradient(180deg, #FFFFFF 0%, #DDF1FA 100%);
  clip-path: polygon(0 0, 100% 0, 50% 100%);
  border-top-left-radius: 14px;
  border-top-right-radius: 14px;
  transform-origin: top center;
  transition: transform 0.75s cubic-bezier(0.34, 1.4, 0.64, 1), opacity 0.45s ease;
  z-index: 5;
  pointer-events: none;
  filter: drop-shadow(0 4px 6px rgba(64, 92, 112, 0.12));
}

.envelope.is-open .envelope-flap {
  transform: rotateX(180deg);
  z-index: 1;
}

/* Sello de corazón */
.wax-seal {
  position: absolute;
  top: 52%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 50px;
  height: 50px;
  border-radius: 50%;
  background: radial-gradient(circle at 30% 30%, #96BDD4, #405C70);
  color: var(--blanco-nieve);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 6;
  box-shadow: 0 6px 14px rgba(64, 92, 112, 0.28), inset 0 1px 2px rgba(255,255,255,0.6);
  border: 2px solid rgba(255, 255, 255, 0.75);
  transition: transform 0.4s ease, opacity 0.35s ease;
  pointer-events: none;
}

.envelope.is-open .wax-seal {
  opacity: 0;
  transform: translate(-50%, -50%) scale(0.5);
}

/* Carta interior que crece */
.letter-card {
  position: absolute;
  left: 6%;
  right: 6%;
  bottom: 10px;
  height: 84%;
  background: var(--blanco-nieve);
  border-radius: 14px;
  border: 1px solid var(--plateado-sutil);
  box-shadow: 0 10px 28px var(--sombra-suave);
  z-index: 2;
  opacity: 0;
  transform: translateY(12px) scale(0.92);
  transition: transform 0.75s cubic-bezier(0.22, 1, 0.36, 1) 0.25s,
              opacity 0.5s ease 0.25s,
              inset 0.6s ease 0.25s;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.envelope.is-open .letter-card {
  inset: 0;
  height: 100%;
  z-index: 10;
  opacity: 1;
  transform: translateY(0) scale(1);
  box-shadow: 0 20px 44px var(--sombra-fuerte);
}

.envelope.is-open .envelope-pocket,
.envelope.is-open .envelope-back,
.envelope.is-open .envelope-flap {
  opacity: 0;
}

.letter-inner {
  padding: 22px 20px;
  overflow-y: auto;
  max-height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  background-image: radial-gradient(var(--celeste-claro) 0.75px, transparent 0.75px);
  background-size: 18px 18px;
}

.letter-ornament {
  color: var(--azul-grisaceo);
  font-size: 0.9rem;
  letter-spacing: 0.35em;
}

.letter-body {
  font-family: var(--font-sans);
  font-size: 0.93rem;
  line-height: 1.62;
  color: var(--azul-oscuro);
  white-space: pre-line;
  text-align: center;
}

.welcome-dedication {
  font-size: 0.9rem;
  color: var(--azul-oscuro);
  opacity: 0.88;
  margin-bottom: 18px;
  transition: opacity 0.35s ease;
}

/* Botones principales */
.btn-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 14px 30px;
  border-radius: 999px;
  border: none;
  background: linear-gradient(135deg, var(--azul-oscuro) 0%, var(--azul-profundo) 100%);
  color: var(--blanco-nieve);
  font-family: var(--font-sans);
  font-size: 0.86rem;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  cursor: pointer;
  box-shadow: 0 10px 24px rgba(64, 92, 112, 0.28);
  transition: transform 0.22s ease, box-shadow 0.22s ease, opacity 0.3s ease;
}

.btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 14px 28px rgba(64, 92, 112, 0.34);
}

.btn-primary:active {
  transform: scale(0.95);
}

.btn-start {
  padding: 12px 28px;
  font-size: 0.84rem;
}

.btn-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 10px 20px;
  border-radius: 999px;
  border: 1px solid var(--celeste-pastel);
  background: var(--azul-hielo);
  color: var(--azul-oscuro);
  font-family: var(--font-sans);
  font-size: 0.84rem;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.2s ease, transform 0.18s ease;
}

.btn-secondary:hover {
  background: var(--celeste-claro);
}

.btn-secondary:active {
  transform: scale(0.96);
}

/* ==========================================================================
   PANTALLA 2: CALENDARIO PRINCIPAL
   ========================================================================== */
.screen-calendar {
  padding: 54px 14px 48px;
  max-width: 980px;
  margin: 0 auto;
}

.calendar-header {
  text-align: center;
  margin-bottom: 26px;
  padding: 0 8px;
}

.winter-illustration {
  margin: 0 auto 6px;
  display: flex;
  justify-content: center;
}

.calendar-title {
  font-family: var(--font-serif);
  font-size: clamp(2.1rem, 6.5vw, 3.2rem);
  font-weight: 700;
