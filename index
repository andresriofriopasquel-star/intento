}

.calendar-caption {
  font-size: 0.9rem;
  color: var(--azul-oscuro);
  opacity: 0.85;
  margin-bottom: 18px;
}

/* Barra de progreso */
.progress-box {
  max-width: 420px;
  margin: 0 auto;
  background: rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 1px solid rgba(255, 255, 255, 0.9);
  border-radius: 16px;
  padding: 12px 16px;
  box-shadow: 0 6px 20px var(--sombra-suave);
}

.progress-text-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.82rem;
